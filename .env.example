# Variables para correr zeal-realtime-gateway en el host (./mvnw spring-boot:run). Valores de DESARROLLO: nunca reales.
# Tabla completa y descripción: GUIA_PASO_A_PASO_BACKEND.md (zeal-infra-compose), sección 7.
APP_TIME_ZONE=America/Bogota
CORS_ALLOWED_ORIGINS=http://localhost:3000
EVENT_CLAIM_WINDOW=30s
JWT_ISSUER=zeal
JWT_SECRET=ZealMVP2026ArchitectureSoftwareSecretKeyMinimum256Bits!!
LOG_FORMAT=logstash
PRESENCE_SWEEP_INTERVAL=10s
PRESENCE_TTL=30s
RABBITMQ_CLIENT_LOGIN=zeal
RABBITMQ_CLIENT_PASSCODE=zeal-dev-password
RABBITMQ_HOST=localhost
RABBITMQ_STOMP_PORT=61613
RABBITMQ_SYSTEM_LOGIN=zeal
RABBITMQ_SYSTEM_PASSCODE=zeal-dev-password
RABBITMQ_VHOST=/
REDIS_HOST=localhost
REDIS_PASSWORD=
REDIS_PORT=6379
SERVER_PORT=8083
SHUTDOWN_TIMEOUT=20s
STOMP_INBOUND_THREADS=8
STOMP_OUTBOUND_THREADS=8
TELEMETRY_REQUESTS_PER_MINUTE=30
WELLBEING_BASE_URL=http://localhost:8081
